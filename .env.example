# ShikshaSetu - copy to .env and edit. Never commit .env.
APP_ENV=local                 # local | demo | production (production refuses demo mode / placeholder secrets)
DEMO_MODE=true

# --- Database -------------------------------------------------------------
# Hosted Supabase PostgreSQL: use the DIRECT connection string (port 5432) or the
# SESSION pooler, from Supabase > Project Settings > Database. Do NOT use the
# transaction pooler (port 6543): the app relies on SET LOCAL inside transactions
# and Alembic needs a session connection.
# Format: postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
# Used only by `pytest` (a throwaway database that tests may drop and recreate).
# Never point this at your hosted Supabase project.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54323/postgres

# --- Secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=CHANGE_ME_dev_only_jwt_secret_please_replace_0123456789
JWT_TTL_MINUTES=60
SESSION_IDLE_MINUTES=30
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=CHANGE_ME_dev_only_master_key_base64_placeholder_____
IDENTITY_HMAC_KEY=CHANGE_ME_dev_only_identity_hmac_key_placeholder
IDENTITY_HMAC_KEY_VERSION=1

# --- Seed ---------------------------------------------------------------
SEED_PROFILE=standard         # minimal | standard
SEED_RNG=20261026
SEED_ANCHOR_DATE=             # blank = today
SEED_DEMO_PASSWORD=1234       # demo only

# --- Services -----------------------------------------------------------
MOCK_SERVICES_URL=http://127.0.0.1:8002
REGISTRY_TIMEOUT_MS=2000
REGISTRY_BREAKER_THRESHOLD=5
REGISTRY_BREAKER_RESET_S=30
SMS_FIXED_OTP=                # e.g. 123456 for demos; leave blank for random OTPs
WORKER_MODE=process           # process | inline (tests)
STORAGE_DIR=./data/objects
WORM_DIR=./data/worm
KEYS_DIR=./data/keys
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8000/api/v1
# Separate verification service (credentials, verifier portal, public status page)
PUBLIC_VERIFY_URL=http://localhost:8001
VITE_VERIFY_URL=http://localhost:8001
# Webhook targets on private/loopback addresses are blocked unless this is true (defaults to true only in DEMO_MODE, for the local demo sink)
ALLOW_PRIVATE_WEBHOOK_URLS=
